<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="420.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="whimsybot.gui.MainWindow"
            stylesheets="@main.css">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    AnchorPane.bottomAnchor="48.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="8.0" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" promptText="Type a command..."
                   onAction="#handleUserInput"
                   AnchorPane.bottomAnchor="6.0" AnchorPane.leftAnchor="6.0"
                   AnchorPane.rightAnchor="86.0" />
        <Button mnemonicParsing="false" onAction="#handleUserInput" text="Send"
                AnchorPane.bottomAnchor="6.0" AnchorPane.rightAnchor="6.0" />
    </children>
</AnchorPane>
